---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';
import { SITE_DESCRIPTION, SITE_TITLE, SITE_HOME_IMG } from '../consts';
---
<style>
:global(.index-page .page-background) {
	justify-content: flex-start;
}

:global(.index-page .page-content) {
	margin: 0;
	margin-left: 4rem;
}
</style>

<Layout
	title={SITE_TITLE}
	description={SITE_DESCRIPTION}
	pageClass="index-page"
>
		<div>
			<h1>🐻 Hi!</h1>
			<p>
				Welcome to Squi's little world. Here is a warm coffee and freshly baked cookies for you 🍪☕. Make yourself comfortable and enjoy your stay 💛
			</p>
		</div>
		<img src={SITE_HOME_IMG} alt="Squi in the corner"
		class="w-[40%] absolute bottom-0 right-0"
		/>
</Layout>
