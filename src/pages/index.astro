---
import Layout from '../layouts/Layout.astro';
import { SITE_HOME_IMG } from '../consts';
---
<style>
:global(.index-page .page-content) {
	display: flex;
	flex-direction: row;
	align-items: center;
	width: min(720px, 100%);
	padding-right: 0;
	padding-left: 0;
}
:global(.index-page main) {

}

.squi {
	width: 50%;
	max-height: 100%;
	z-index: -1;
	align-self: flex-end;
}

@media (max-width: 720px) {
	:global(.index-page .page-content) {
		flex-direction: column;
		flex-grow: 1;
		justify-content: space-between;
		margin-top: 8vh;
	}
	.squi {
		width: 85%;
	}
}
</style>

<Layout
	pageClass="index-page"
>
		<div>
			<h1>🐻 Hi!</h1>
			<p>
				Welcome to Squi's little world. Here is a warm coffee and freshly baked cookies for you 🍪☕. Make yourself comfortable and enjoy your stay 💛
			</p>
		</div>
		<img src={SITE_HOME_IMG.src} alt="Squi in the corner"
		class="squi"
		/>
</Layout>
