---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro'; 
import FormattedDate from '../components/FormattedDate.astro';
import { Image } from 'astro:assets';
const {
  title,
  description,
  heroImage,
  heroAlt = 'Hero image',
  backgroundImage,
  pageClass,
  pubDate,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <style>
      main {
        width: 100%;
        max-width: 100%;
        display: flex;
        flex-direction: column;
        flex: 1 1 auto;
        position: relative;
        /* background behavior formerly on .page-background */
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        align-items: center;
        justify-content: center;
        padding: 0;
        margin: 0;
      }

      .hero-wrapper {
        width: 100%;
        margin: 0;
      }

      .hero-image {
        width: 100%;
      }

      .hero-image img {
        display: block;
        margin: 0 auto;
        margin-block-start: 2em;
        border-radius: 12px;
        box-shadow: var(--box-shadow);
        width: calc(100% - 2em);
        max-width: 800px;
      }

      .page-content {
        width: 720px;
        max-width: calc(100% - 2em);
        margin: 0 auto;
        padding: 1em;
        color: rgb(var(--gray-dark));
        font-size: 20px;
        line-height: 1.7;
      }

      .title {
        padding: 1em 0;
        text-align: center;
        line-height: 1;
      }

      .title h1 {
        margin: 0 0 0.3em 0;
      }

      .date {
        margin-bottom: 0.5em;
        color: rgb(var(--gray));
      }

      .last-updated-on {
        font-style: italic;
      }

      .page-content :global(h1),
      .page-content :global(h2),
      .page-content :global(h3),
      .page-content :global(h4),
      .page-content :global(h5),
      .page-content :global(h6) {
        line-height: 1.2;
      }

      @media (max-width: 720px) {
        main {
            min-height: 100%;
        }
      }
    </style>
  </head>
  <body class={ `min-h-screen bg-[var(--background)] text-[var(--text)] ${pageClass ?? ''}`}>
    <Header />
    <main style={backgroundImage ? `background-image: url('${backgroundImage}');` : ''}>
        <div class="hero-image">
            {heroImage && (
                typeof heroImage === 'string' ? (
                <img src={heroImage} alt={heroAlt} />
                ) : (
                <Image width={1020} height={510} src={heroImage} alt={heroAlt} />
                )
            )}
        </div>
        <article class="page-content">
            {title && <div class="title">
            {pubDate && (
              <div class="date">
                <FormattedDate date={pubDate} />
              </div>
            )}
            <h1>{title}</h1>
            <hr />
          </div>}

          <slot />
        </article>
    </main>
    <Footer />
  </body>
</html>